# Byte-compiled / Python artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Virtual Environment
venv/
ENV/
env/

# Raw dataset: 31 GB of NIfTI volumes, individually over GitHub's 100 MB
# file limit. Only the manifest is committed, as a reference for the layout
# src/config.py expects; see README.md for where to download the rest.
archive/*
!archive/dataset.json

# Derived data that regenerates from the raw archive + code, so committing it
# would just be a second, driftable copy of something reproducible.
output/preprocessed/
output/results.zip

# Working files not part of the published project: personal notes, Kaggle
# notebook drafts and their logs, downloaded result archives already unpacked
# into output/experiments/, and Radu's review (addressed to him, not public).
Stages.md
Readme_Radu.md
Review_Radu.md
docs/
kaggle_notebooks/
kaggle_upload/
full-experiments*.ipynb
*.log
params.txt
download.txt
archive.zip
all_experiments.zip
results_*.zip

# Editors, IDE assistants & OS artifacts
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db
